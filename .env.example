# Copy this file to `.env` (already gitignored) and fill in real values.
# These are injected at BUILD time by Vite, so they must be present in the
# build environment (local shell AND your hosting provider's env settings),
# not just at runtime.
#
# NOTE: This app builds into a single static bundle, so any VITE_* value here
# still ships to the browser. Treat this as interim hardening (keeps secrets
# out of source/git). The LLM key below is a budget-capped LiteLLM proxy key,
# so a leak is revocable — but for a real fix, proxy the calls server-side.

# LiteLLM proxy virtual key (OpenAI-compatible). Budget-capped & revocable.
VITE_LLM_API_KEY=sk-your-litellm-key
# Optional — defaults to the classplus LiteLLM proxy if unset.
VITE_LLM_ENDPOINT=https://litellm.classplusapp.com/v1/chat/completions

# Supabase project (anon key is public by design; relies on Row-Level Security)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Staff portal passwords (?admin=1 / ?students=1 use ADMIN, ?faculty=1 uses FACULTY)
VITE_ADMIN_PASSWORD=set-a-new-admin-password
VITE_FACULTY_PASSWORD=set-a-new-faculty-password
