+{q:"'das Auge' means?",opts:["ear","eye","nose","mouth"],ans:1},
+{q:"'Danke schön' means?",opts:["Please","Sorry","Thank you very much","Good day"],ans:2},
+{q:"'rot' is which colour?",opts:["blue","green","red","yellow"],ans:2},
+{q:"'die Mutter' means?",opts:["father","sister","mother","daughter"],ans:2},
